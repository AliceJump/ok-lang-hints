{
  "name": "ok-lang-hints",
  "displayName": "ok-script Lang Hints",
  "description": "为 ok-script 的 self.lang 与 FeatureList/fL 提供智能补全、值提示、类型区分、模板 hover 预览和图片缓存。",
  "version": "0.3.0",
  "publisher": "AliceJump",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/AliceJump/ok-lang-hints.git"
  },
  "homepage": "https://github.com/AliceJump/ok-lang-hints#readme",
  "bugs": {
    "url": "https://github.com/AliceJump/ok-lang-hints/issues"
  },
  "keywords": [
    "ok-script",
    "python",
    "localization",
    "inlay hints",
    "FeatureList",
    "template matching"
  ],
  "galleryBanner": {
    "color": "#172554",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:python",
    "onLanguage:json",
    "onLanguage:jsonc"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "okLangHints.showTemplates",
        "title": "打开模板面板",
        "category": "ok-script Lang Hints"
      },
      {
        "command": "okLangHints.openTemplatesEditor",
        "title": "在编辑器中打开模板面板（大窗口）",
        "category": "ok-script Lang Hints"
      },
      {
        "command": "okLangHints.showTaskLauncher",
        "title": "打开任务启动",
        "category": "ok-script Lang Hints"
      },
      {
        "command": "okLangHints.openCharacterManager",
        "title": "打开角色技能管理面板",
        "category": "ok-script Lang Hints"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "okLangHints",
          "title": "ok-script 模板",
          "icon": "media/templates.svg"
        }
      ]
    },
    "views": {
      "okLangHints": [
        {
          "type": "webview",
          "id": "okLangHints.templateGallery",
          "name": "模板面板",
          "icon": "media/templates.svg",
          "webviewOptions": {
            "retainContextWhenHidden": true
          }
        },
        {
          "type": "webview",
          "id": "okLangHints.taskLauncher",
          "name": "任务启动",
          "icon": "media/task.svg",
          "webviewOptions": {
            "retainContextWhenHidden": true
          }
        },
        {
          "type": "webview",
          "id": "okLangHints.toolbox",
          "name": "工具箱",
          "icon": "media/toolbox.svg"
        }
      ]
    },
    "keybindings": [
      {
        "command": "okLangHints.showTemplates",
        "key": "ctrl+alt+t",
        "mac": "cmd+alt+t",
        "when": "editorLangId == python"
      }
    ],
    "configuration": {
      "title": "ok-script Lang Hints",
      "properties": {
        "okLangHints.langDirectory": {
          "type": "string",
          "default": "assets/lang",
          "description": "lang JSON 目录（相对于工作区根目录）。"
        },
        "okLangHints.poDirectory": {
          "type": "string",
          "default": "i18n",
          "description": "gettext PO 目录（相对于工作区根目录），按 <locale>/LC_MESSAGES/*.po 结构扫描；文件名（domain）作为 lang 模块，msgid 作为 key，msgstr 作为值。"
        },
        "okLangHints.enablePoData": {
          "type": "boolean",
          "default": true,
          "description": "是否启用 gettext PO 数据源（读取 poDirectory 下的 .po 文件，并与 lang JSON 合并）。"
        },
        "okLangHints.poDomains": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "ocr"
          ],
          "description": "要加载的 gettext PO domain（文件名，不含 .po 后缀）；仅列出的 domain 会作为 lang 模块。默认只加载 ocr，排除 ok 等 UI 通用文案。"
        },
        "okLangHints.displayLocale": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "zh_CN",
            "zh_TW",
            "en_US",
            "ja_JP",
            "ko_KR",
            "es_ES"
          ],
          "description": "幽灵注释/hover 使用的默认语言；auto = 跟随 VS Code UI 语言。hover 始终显示全部语言。"
        },
        "okLangHints.enableInlayHints": {
          "type": "boolean",
          "default": true,
          "description": "是否启用幽灵注释（在 self.lang.X.Y 后行内显示对应值）。"
        },
        "okLangHints.featureAliases": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "fL",
            "FeatureList"
          ],
          "description": "FeatureList 模板的可用别名（补全和 hover 均按此识别）。默认支持 fL 与 FeatureList；例如 [\"fL\", \"FeatureList\"]。"
        },
        "okLangHints.effectsFile": {
          "type": "string",
          "default": "src/data/effects.py",
          "description": "技能效果 ID 定义文件（含 EffectType 枚举与 EFFECT_DESCRIPTIONS 的 effects.py，相对于工作区根目录）。用于 EffectType.XXX / effect_id: \"XXX\" 的 hover、补全与幽灵注释。"
        },
        "okLangHints.okScriptProjectPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "ok-script 游戏项目根目录（含 src/config.py 的目录），如 `D:/items/project/github_project/ok-end-field`。任务启动面板从该项目的 `src/config.py` 读取任务列表。"
        },
        "okLangHints.okScriptPython": {
          "type": "string",
          "default": "",
          "markdownDescription": "用于运行 ok-script 任务的 Python 解释器路径。留空时自动使用 `<项目路径>/.venv/Scripts/python.exe`（Windows）。"
        },
        "okLangHints.characterProjectPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "角色技能管理面板的数据项目根目录。留空时依次使用 `okScriptProjectPath` 和当前工作区。"
        },
        "okLangHints.characterMasterFile": {
          "type": "string",
          "default": "assets/data/characters.json",
          "description": "角色主表 JSON，相对于角色数据项目根目录。"
        },
        "okLangHints.characterSkillsDirectory": {
          "type": "string",
          "default": "assets/data/character_skills",
          "description": "角色技能 JSON 目录，相对于角色数据项目根目录。"
        },
        "okLangHints.characterLocaleFile": {
          "type": "string",
          "default": "assets/lang/characters.json",
          "description": "角色名称多语言 JSON，相对于角色数据项目根目录。"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.4.0"
  }
}
